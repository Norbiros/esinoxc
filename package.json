{
  "name": "esinoxc",
  "version": "0.0.0",
  "description": "Run ESLint plugins inside oxlint.",
  "homepage": "https://github.com/Norbiros/esinoxc#readme",
  "bugs": {
    "url": "https://github.com/Norbiros/esinoxc/issues"
  },
  "license": "MIT",
  "author": "Norbiros <norbiros@protonmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Norbiros/esinoxc.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./plugins/vue": "./dist/plugins/vue.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepare": "vp config",
    "prepack": "vpr build"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:runtime",
    "eslint": "catalog:runtime"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:publish",
    "@types/node": "catalog:toolchain",
    "@typescript-eslint/parser": "catalog:examples",
    "eslint-plugin-vue": "catalog:examples",
    "oxlint": "catalog:toolchain",
    "pkg-pr-new": "catalog:publish",
    "publint": "catalog:publish",
    "typescript": "catalog:toolchain",
    "vite": "catalog:toolchain",
    "vite-plus": "catalog:toolchain"
  },
  "peerDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "oxlint": ">=1.85.0"
  },
  "peerDependenciesMeta": {
    "@typescript-eslint/parser": {
      "optional": true
    },
    "eslint-plugin-vue": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.9.1"
}
